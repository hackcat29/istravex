{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hackcat29/istravex/corpus/manifest.schema.json",
  "title": "Istravex fixture manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "pattern",
    "cap_ids",
    "protocol_version",
    "network",
    "xdr_type",
    "xdr_path",
    "sha256",
    "source",
    "synthetic",
    "files"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^(cap[0-9]+|base)-[a-z0-9-]+-(pubnet|testnet|local|synthetic)-[0-9]{4}$",
      "description": "<cap>-<pattern>-<network>-<nnnn>. `base` instead of a CAP for shapes the base protocol already allowed (memo bytes, maximum-length vectors)."
    },
    "pattern": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "The ledger pattern the fixture exercises, e.g. muxed-payment. Runners and scorers dispatch on it."
    },
    "cap_ids": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "string",
        "pattern": "^CAP-[0-9]{4}(-[0-9]{2})?$"
      },
      "description": "CAPs whose XDR the fixture exercises; the first is primary. Empty only for base-protocol shapes (id prefix base-)."
    },
    "protocol_version": {
      "type": "integer",
      "minimum": 1
    },
    "network": {
      "enum": [
        "pubnet",
        "testnet",
        "local",
        "synthetic"
      ]
    },
    "xdr_type": {
      "$ref": "#/$defs/xdrType"
    },
    "xdr_path": {
      "type": "string",
      "minLength": 1
    },
    "sha256": {
      "$ref": "#/$defs/sha256"
    },
    "source": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "captured",
            "generated",
            "synthetic"
          ]
        },
        "network_endpoint": {
          "type": "string",
          "format": "uri"
        },
        "ledger": {
          "type": "integer",
          "minimum": 1
        },
        "tx_hash": {
          "$ref": "#/$defs/sha256"
        },
        "closed_at": {
          "type": "string",
          "format": "date-time"
        },
        "generator": {
          "type": "object",
          "description": "Present when kind is generated: the pinned stellar-core that produced the fixture (kit/capture/generate.mjs).",
          "required": [
            "core_version",
            "binary_sha256",
            "protocol_version"
          ],
          "properties": {
            "core_version": {
              "type": "string"
            },
            "build": {
              "type": "string"
            },
            "binary_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "protocol_version": {
              "type": "integer"
            },
            "soroban_limits_factor": {
              "type": "integer"
            },
            "seed": {
              "type": "string",
              "description": "Key-derivation seed; with the pinned binary, regenerating with the same seed reproduces every XDR byte."
            },
            "network_passphrase": {
              "type": "string"
            },
            "close_time_base": {
              "type": "integer"
            },
            "probe_wasm_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "close_time_step": {
              "type": "integer"
            }
          }
        },
        "description": {
          "type": "string",
          "description": "For synthetic fixtures: how the bytes were built and from what."
        },
        "derived_from": {
          "type": "string",
          "description": "For synthetic fixtures: the fixture whose bytes they start from, if any."
        },
        "network_passphrase": {
          "type": "string"
        },
        "related": {
          "type": "array",
          "description": "Other transactions some files come from (each file listed comes from that transaction, not the primary one).",
          "items": {
            "type": "object",
            "required": [
              "ledger",
              "tx_hash",
              "files"
            ],
            "properties": {
              "ledger": {
                "type": "integer",
                "minimum": 1
              },
              "tx_hash": {
                "$ref": "#/$defs/sha256"
              },
              "files": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "required": [
        "kind"
      ],
      "if": {
        "properties": {
          "kind": {
            "const": "synthetic"
          }
        }
      },
      "then": {
        "required": [
          "kind",
          "description"
        ]
      },
      "else": {
        "required": [
          "kind",
          "network_endpoint",
          "ledger",
          "closed_at"
        ],
        "description": ""
      },
      "description": " Captured fixtures name the transaction (tx_hash); a whole-ledger fixture (pattern ledger) has none."
    },
    "synthetic": {
      "type": "boolean"
    },
    "expected_decoded": {
      "type": "object"
    },
    "expected_indexed": {
      "type": "object"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "xdr_type",
          "path",
          "sha256",
          "bytes"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "xdr_type": {
            "$ref": "#/$defs/xdrType"
          },
          "path": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*\\.xdr\\.b64$"
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          },
          "bytes": {
            "type": "integer",
            "minimum": 1
          },
          "expect": {
            "enum": [
              "decode_error"
            ],
            "description": "Set when a conforming decoder must reject these bytes."
          }
        }
      }
    },
    "sightings": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+#[0-9]+$"
      },
      "description": "Upstream issues or PRs this fixture reproduces, as owner/repo#number."
    },
    "covers": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9.]+:[A-Za-z0-9_]+$"
      },
      "description": "The XDR cells (union arms, or interpreted flag bits) this fixture was chosen to cover, as kit/go/cmd/shape-scan names them. Set by kit/capture/shapes.mjs."
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "xdrType": {
      "enum": [
        "TransactionEnvelope",
        "TransactionResult",
        "TransactionMeta",
        "LedgerEntryData",
        "LedgerEntryChanges",
        "ScVal",
        "LedgerCloseMeta"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "network": {
            "const": "synthetic"
          }
        }
      },
      "then": {
        "properties": {
          "synthetic": {
            "const": true
          },
          "source": {
            "properties": {
              "kind": {
                "const": "synthetic"
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "synthetic": {
            "const": false
          }
        }
      }
    }
  ]
}
