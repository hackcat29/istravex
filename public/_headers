# Cloudflare Workers static assets: response headers for istravex.com.
# Vite copies this file into dist/; Cloudflare reads it and does not serve it.

/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  X-Frame-Options: DENY

# Vite fingerprints everything under /assets/, so it never changes in place.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
