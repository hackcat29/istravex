{
  "name": "istravex-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p . && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p .",
    "test:e2e": "playwright test",
    "corpus:capture": "node kit/capture/mainnet.mjs && node kit/capture/testnet.mjs",
    "corpus:js": "node kit/runners/js/run.mjs",
    "corpus:go": "cd kit/runners/go && go run . ../../../corpus",
    "corpus:rust": "cd kit/runners/rust && cargo run --release -q -- ../../../corpus",
    "corpus:replay": "node kit/replay/replay.mjs",
    "corpus:data": "node kit/site-data.mjs",
    "corpus:run": "npm run corpus:js && npm run corpus:go && npm run corpus:rust && npm run corpus:replay && npm run corpus:data"
  },
  "dependencies": {
    "@babylonjs/core": "^9.36.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "motion": "^14.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "typegpu": "^0.12.10"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@stellar/stellar-sdk": "^17.4.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@webgpu/types": "^0.1.74",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vite": "^8.3.8"
  }
}
