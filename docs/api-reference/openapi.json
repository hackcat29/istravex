            }
          },
          "network": {
            "type": "string"
          },
          "protocol_version": {
            "type": "integer"
          },
          "ledger": {
            "type": "integer"
          },
          "tx_hash": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "captured",
              "generated"
            ]
          },
          "xdr_type": {
            "type": "string"
          },
          "sha256": {
            "type": "string"
          },
          "files": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "Manifest": {
        "type": "object",
        "description": "A fixture manifest. Full schema: https://github.com/hackcat29/istravex/blob/main/corpus/manifest.schema.json",
        "properties": {
          "id": {
            "type": "string"
          },
          "cap_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "protocol_version": {
            "type": "integer"
          },
          "network": {
            "type": "string"
          },
          "xdr_type": {
            "type": "string"
          },
          "xdr_path": {
            "type": "string"
          },
          "sha256": {
            "type": "string"
          },
          "source": {
            "type": "object"
          },
          "synthetic": {
            "type": "boolean"
          },
          "expected_decoded": {
            "type": "object"
          },
          "expected_indexed": {
            "type": "object"
          },
          "files": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
