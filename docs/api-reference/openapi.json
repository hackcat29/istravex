    "/v1/ledgers/{network}/{seq}": {
      "get": {
        "tags": [
          "Ledgers"
        ],
        "summary": "Download a canonical ledger",
        "operationId": "getLedger",
        "description": "The full `LedgerCloseMeta` a fixture was verified against, as a zstd-compressed `LedgerCloseMetaBatch` (the layout of SDF's public data lake). `X-Content-SHA256` is the sha256 of the decompressed XDR.",
        "parameters": [
          {
            "name": "network",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "pubnet",
                "testnet",
                "local"
              ]
            }
          },
          {
            "name": "seq",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "example": 65474279
            }
