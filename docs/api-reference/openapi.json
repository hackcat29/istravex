    "/rpc/{network}": {
      "post": {
        "tags": [
          "RPC"
        ],
        "summary": "Mock Stellar RPC",
        "operationId": "rpc",
        "description": "JSON-RPC 2.0 with the wire shapes of Stellar RPC. Supports `getHealth`, `getNetwork`, `getLatestLedger` and `getLedgers` (cursor paging over the corpus's sparse ledgers). Point an RPC-backed indexer at `https://rpc.istravex.com/{network}` to replay the corpus. Batches of up to 20 requests; bodies up to 64 KB.",
        "parameters": [
          {
            "name": "network",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "pubnet",
                "testnet",
                "local"
              ]
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/JsonRpcRequest"
              },
              "example": {
                "jsonrpc": "2.0",
                "id": 1,
                "method": "getLedgers",
                "params": {
                  "startLedger": 65474279,
                  "pagination": {
                    "limit": 1
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonRpcResponse"
                },
                "example": {
                  "jsonrpc": "2.0",
                  "id": 1,
                  "result": {
                    "status": "healthy",
                    "latestLedger": 65474309,
                    "latestLedgerCloseTime": "1794657587",
                    "oldestLedger": 65474279,
                    "oldestLedgerCloseTime": "1794657437",
                    "ledgerRetentionWindow": 31
                  }
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": {
                    "code": "not_found",
                    "message": "Fixture not found"
                  }
                }
              }
            }
          },
          "413": {
            "description": "Body over 64 KB"
          },
          "429": {
            "description": "Rate limited",
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
