{
  "openapi": "3.1.0",
  "info": {
    "title": "Istravex API",
    "version": "1.0.0",
    "description": "Read-only access to the Istravex corpus: fixtures, their raw XDR, the canonical ledgers they were verified against, and the kit's results. Also hosts a mock Stellar RPC that replays the corpus for any RPC-backed indexer.",
    "license": {
      "name": "Apache-2.0",
      "url": "https://www.apache.org/licenses/LICENSE-2.0"
    },
    "contact": {
      "url": "https://github.com/hackcat29/istravex"
    }
  },
  "servers": [
    {
      "url": "https://api.istravex.com",
      "description": "Production"
    },
    {
      "url": "http://localhost:8080",
      "description": "Local (`npm run api`)"
    }
  ],
  "tags": [
    {
      "name": "Service"
    },
    {
      "name": "Fixtures"
    },
    {
      "name": "Ledgers"
    },
    {
      "name": "Results"
    },
    {
      "name": "RPC"
    }
  ],
  "paths": {
    "/v1/health": {
      "get": {
        "tags": [
          "Service"
        ],
        "summary": "Health",
        "operationId": "getHealth",
        "description": "Liveness and the build the server is running. Never cached.",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                },
                "example": {
                  "status": "ok",
                  "version": "41398ce",
                  "uptime_s": 3600,
                  "fixtures": 6,
                  "rpc_networks": [
                    "pubnet",
                    "testnet",
                    "local"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/v1/stats": {
      "get": {
        "tags": [
          "Service"
        ],
        "summary": "Corpus statistics",
        "operationId": "getStats",
        "description": "The headline numbers: fixtures, SDK checks, provenance checks, golden frames, the wallet-backend pilot and CAP coverage.",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Stats"
                },
                "example": {
                  "fixtures": 6,
                  "caps": 4,
                  "networks": [
                    "local",
                    "pubnet",
                    "testnet"
                  ],
                  "sdk_checks": {
                    "passed": 54,
                    "total": 54
                  },
                  "provenance_checks": {
                    "passed": 62,
                    "total": 62
                  },
                  "golden_frames": {
                    "exact": 15306,
                    "total": 15306
                  },
                  "wallet_backend_pilot": {
                    "correct": 6,
                    "total": 6
                  },
                  "cap_coverage": {
                    "live": 70,
                    "xdr_changing": 40,
                    "xdr_covered": 3
                  }
                }
              }
            }
          },
          "429": {
            "description": "Rate limited",
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/fixtures": {
      "get": {
        "tags": [
          "Fixtures"
        ],
        "summary": "List fixtures",
        "operationId": "listFixtures",
        "parameters": [
          {
            "name": "cap",
            "in": "query",
            "schema": {
              "type": "string",
              "example": "CAP-0027"
            },
            "description": "Only fixtures for this CAP."
          },
          {
            "name": "network",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "pubnet",
                "testnet",
                "local"
              ]
            },
            "description": "Only fixtures from this network."
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "fixtures"
                  ],
                  "properties": {
                    "fixtures": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/FixtureSummary"
                      }
                    }
                  }
                },
                "example": {
                  "fixtures": [
                    {
                      "id": "cap15-fee-bump-pubnet-0001",
                      "cap_ids": [
                        "CAP-0015"
                      ],
                      "network": "pubnet",
